# Optional local configuration. The offline demo requires no credentials.
# Copy to .env in the working directory; never commit .env or private keys.

# Kalshi credentials are optional for REST reads and required for WebSocket.
KALSHI_API_KEY_ID=
#KALSHI_PRIVATE_KEY_PATH=.secrets/kalshi-api-key.pem

# Live APIs require --allow-network. Continuous capture also requires
# --continuous; the experimental loop includes historical backfills.
# No service is installed automatically.
#PMKT_DATA_DIR=./workspace
#PMKT_RPS=2
#PMKT_POLYMARKET_RPS=2.5

# The default disk probe follows PMKT_DATA_DIR, using its nearest existing
# parent before first capture. Override for a dedicated capture volume.
#PMKT_CAPTURE_DISK_PATH=./workspace
#PMKT_CAPTURE_MIN_FREE_GB=60
#PMKT_CAPTURE_RECHECK_SECONDS=30

# Analytical ceilings. Large experimental builds can fail at these limits.
#PMKT_DUCKDB_MEMORY_LIMIT=4GB
#PMKT_DUCKDB_THREADS=4
#PMKT_DUCKDB_SPILL_LIMIT=1GB
#PMKT_COMPACT_MEMORY_LIMIT=4GB
#PMKT_COMPACT_THREADS=4
